server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Use Kubernetes DNS resolver with short TTL to handle pod IP changes
    # kube-dns is at 10.96.0.10 by default in most K8s clusters
    # Use 'valid=10s' to re-resolve every 10 seconds
    resolver kube-dns.kube-system.svc.cluster.local valid=10s ipv6=off;
    resolver_timeout 5s;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # SSE Stream - Needs Connection Keep-Alive and No Buffering
    location /api/queueStream {
        # Use variable to force DNS re-resolution on each request
        set $backend "${API_URL}";
        proxy_pass $backend/api/queueStream;
        
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for SSE
        proxy_buffering off;
        proxy_cache off;
        
        # Long timeout for running stream
        proxy_read_timeout 24h;
    }

    # Reverse proxy for API requests
    location /api/ {
        # Use variable to force DNS re-resolution on each request
        set $backend "${API_URL}";
        proxy_pass $backend/api/;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout settings
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 10s;
    }
}
