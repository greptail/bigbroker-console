server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    
    # Use Kubernetes DNS resolver (kube-dns ClusterIP) with 5s TTL
    # This allows NGINX to re-resolve DNS when backend pods change
    resolver 10.96.0.10 valid=5s ipv6=off;
    resolver_timeout 5s;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # SSE Stream - Needs Connection Keep-Alive and No Buffering
    location /api/queueStream {
        # Use variable to force DNS re-resolution on each request
        # API_URL should be in format: hostname:port (without http://)
        set $backend "${API_URL}";
        proxy_pass http://$backend/api/queueStream;
        
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for SSE
        proxy_buffering off;
        proxy_cache off;
        
        # Long timeout for running stream
        proxy_read_timeout 24h;
    }

    # Reverse proxy for API requests
    location /api/ {
        # Use variable to force DNS re-resolution on each request
        # API_URL should be in format: hostname:port (without http://)
        set $backend "${API_URL}";
        proxy_pass http://$backend/api/;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout settings
        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 30s;
    }
}
